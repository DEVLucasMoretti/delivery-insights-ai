# Copie este ficheiro para ".env" e preencha a chave para ligar o agente de IA.
# Sem chave, a aplicação funciona em modo demonstração (sem modelo de linguagem).
ANTHROPIC_API_KEY=

# Opcional: modelo usado pelo agente e limite de perguntas por sessão
# DELIVERY_AI_MODEL=claude-opus-5-5
# LIMITE_PERGUNTAS_SESSAO=20
