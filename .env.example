# Copie este arquivo para ".env". Tudo aqui é opcional.

# Agente de IA. Sem chave, o assistente funciona em modo demonstração (sem modelo de linguagem).
ANTHROPIC_API_KEY=

# Banco de dados da operação (MySQL). Sem DATABASE_URL, a aplicação lê os CSV públicos.
# Os valores abaixo são os do MySQL local do docker-compose.yml (só para desenvolvimento).
#   DATABASE_URL    -> usuário que SÓ LÊ, usado pelo painel e pelo assistente
#   MYSQL_CARGA_URL -> usuário que escreve, usado só por scripts/carregar_mysql.py
# DATABASE_URL=mysql+pymysql://prova_leitura:leitura_local_dev@127.0.0.1:3306/delivery_center
# MYSQL_CARGA_URL=mysql+pymysql://carga:carga_local_dev@127.0.0.1:3306/delivery_center

# Modelo usado pelo agente e limite de perguntas por sessão
# DELIVERY_AI_MODEL=claude-opus-5-5
# LIMITE_PERGUNTAS_SESSAO=20
